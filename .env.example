# ── LLM provider ──────────────────────────────────────────────────────────────
# Use "ollama" for local development, "bedrock" for production
LLM_PROVIDER=ollama

# Ollama (local dev) — https://ollama.com
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# AWS Bedrock (production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_LLM_MODEL_ID=us.anthropic.claude-sonnet-4-5

# ── AWS Transcribe (production only) ──────────────────────────────────────────
TRANSCRIBE_LANGUAGE_CODE=en-US
TRANSCRIBE_SAMPLE_RATE=16000

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite for local dev
DATABASE_URL=sqlite+aiosqlite:///./grocery.db

# PostgreSQL for production
# DATABASE_URL=postgresql+asyncpg://grocery:grocery@localhost:5432/grocery
